{
  "name": "daybook-tasks",
  "version": "1.0.0",
  "private": true,
  "description": "Daybook — to-do list with alarm, vibrate and popup reminders",
  "scripts": {
    "vendor": "esbuild build/firebase-entry.js --bundle --format=esm --minify --target=es2020 --outfile=public/vendor/firebase.js",
    "sync": "cap sync android",
    "apk": "cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/local-notifications": "8.3.1"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0",
    "esbuild": "0.25.0",
    "firebase": "10.12.2"
  }
}
